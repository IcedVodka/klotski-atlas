{
  "name": "klotski-atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 5173 --bind 127.0.0.1 --directory public",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"public/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"public/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\"",
    "test:gpu": "python3 tests/test_layout.py && python3 tests/test_parameter_inference.py"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "description": "华容道棋盘与三维状态图联动的交互式学习项目",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  }
}
